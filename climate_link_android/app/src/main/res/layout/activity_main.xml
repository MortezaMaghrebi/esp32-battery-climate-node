<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:layoutDirection="rtl" android:background="@drawable/bg_atmosphere">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="@dimen/page_gutter" android:paddingEnd="@dimen/page_gutter" android:paddingTop="10dp" android:paddingBottom="4dp" android:baselineAligned="false" android:id="@+id/app_header" android:layoutDirection="ltr">
    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_cloud_brand" android:importantForAccessibility="no" android:padding="3dp" android:layout_marginEnd="6dp" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/brand" android:textAlignment="viewStart" android:textDirection="ltr" android:textSize="16sp" android:textColor="#10143D" android:fontFamily="@font/vazirmatn_semibold" android:gravity="start" android:id="@+id/brand_wordmark" android:maxLines="1" app:autoSizeTextType="uniform" app:autoSizeMinTextSize="12sp" app:autoSizeMaxTextSize="16sp" app:autoSizeStepGranularity="1sp" android:includeFontPadding="false" android:textStyle="bold" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/brand_subtitle" android:textSize="12sp" android:textColor="@color/cl_muted" android:fontFamily="@font/vazirmatn" android:gravity="start" android:id="@+id/brand_tagline" android:includeFontPadding="false" android:visibility="gone" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/offline" android:textSize="11sp" android:textColor="@color/cl_muted" android:fontFamily="@font/vazirmatn" android:gravity="start" android:id="@+id/connection_badge" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:background="@drawable/bg_notice" android:includeFontPadding="false" />
  </LinearLayout>
  <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/operation_progress" android:layout_width="match_parent" android:layout_height="3dp" android:indeterminate="true" android:visibility="invisible" />
  <ViewFlipper android:id="@+id/pages" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <include layout="@layout/page_overview" />
    <include layout="@layout/page_devices" />
    <include layout="@layout/page_settings" />
  </ViewFlipper>
  <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/bottom_nav" android:layout_width="match_parent" android:layout_height="80dp" android:background="@drawable/bg_dock" app:menu="@menu/bottom_navigation" app:labelVisibilityMode="labeled" app:itemIconTint="@color/nav_color" app:itemTextColor="@color/nav_color" app:itemTextAppearanceActive="@style/TextAppearance.ClimateLink.Nav" app:itemTextAppearanceInactive="@style/TextAppearance.ClimateLink.Nav" app:elevation="0dp" app:itemIconSize="24dp" android:layout_marginStart="22dp" android:layout_marginEnd="22dp" android:layout_marginBottom="12dp" android:elevation="6dp" android:paddingTop="0dp" android:paddingBottom="0dp" app:itemActiveIndicatorStyle="@style/Widget.ClimateLink.NavIndicator" android:minHeight="64dp" app:itemBackground="@drawable/nav_lens" />
</LinearLayout>