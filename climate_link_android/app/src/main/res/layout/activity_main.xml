<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:layoutDirection="rtl" android:background="@color/cl_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="@dimen/page_gutter" android:paddingEnd="@dimen/page_gutter" android:paddingTop="12dp" android:paddingBottom="16dp" android:baselineAligned="false" android:id="@+id/app_header">
        <ImageView android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/ic_leaf" app:tint="@color/cl_surface" android:importantForAccessibility="no" android:padding="9dp" android:background="@drawable/bg_logo" android:layout_marginEnd="10dp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/brand" android:textAlignment="viewStart" android:textDirection="ltr" android:textSize="21sp" android:textColor="@color/cl_ink" android:fontFamily="@font/vazirmatn" android:gravity="start" android:id="@+id/brand_wordmark" android:maxLines="1" app:autoSizeTextType="uniform" app:autoSizeMinTextSize="12sp" app:autoSizeMaxTextSize="21sp" app:autoSizeStepGranularity="1sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/brand_subtitle" android:textSize="12sp" android:textColor="@color/cl_muted" android:fontFamily="@font/vazirmatn" android:gravity="start" android:id="@+id/brand_tagline" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/offline" android:textSize="12sp" android:textColor="@color/cl_muted" android:fontFamily="@font/vazirmatn" android:gravity="start" android:id="@+id/connection_badge" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:background="@drawable/bg_offline" />
    </LinearLayout>
    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/operation_progress" android:layout_width="match_parent" android:layout_height="3dp" android:indeterminate="true" android:visibility="invisible" />
    <ViewFlipper android:id="@+id/pages" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <include layout="@layout/page_overview" />
        <include layout="@layout/page_devices" />
        <include layout="@layout/page_settings" />
    </ViewFlipper>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/cl_outline" />
    <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/bottom_nav" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/cl_surface" app:menu="@menu/bottom_navigation" app:labelVisibilityMode="labeled" app:itemIconTint="@color/nav_color" app:itemTextColor="@color/nav_color" app:itemTextAppearanceActive="@style/TextAppearance.ClimateLink.Nav" app:itemTextAppearanceInactive="@style/TextAppearance.ClimateLink.Nav" app:elevation="0dp" />
</LinearLayout>
