                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/server_title" android:textSize="16sp" android:textColor="@color/cl_ink" android:fontFamily="@font/vazirmatn_semibold" android:gravity="start" android:includeFontPadding="false" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/server_caption" android:textSize="12sp" android:textColor="@color/cl_muted" android:fontFamily="@font/vazirmatn" android:gravity="start" android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>
            <Space android:layout_width="1dp" android:layout_height="14dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/server_url" android:textSize="14sp" android:textColor="@color/cl_ink" android:labelFor="@+id/url" android:layout_marginBottom="8dp" android:gravity="start" android:fontFamily="@font/vazirmatn" android:includeFontPadding="false" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" app:placeholderText="@string/server_placeholder" android:id="@+id/url_layout" app:hintEnabled="false">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/url" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="textUri" android:maxLines="1" android:textSize="14sp" android:textDirection="ltr" android:saveEnabled="false" android:imeOptions="actionNext" android:textColor="@color/cl_ink" android:fontFeatureSettings="'tnum'" android:includeFontPadding="false" android:paddingStart="14dp" android:paddingEnd="14dp" />
            </com.google.android.material.textfield.TextInputLayout>
            <Space android:layout_width="1dp" android:layout_height="12dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/server_token" android:textSize="14sp" android:textColor="@color/cl_ink" android:labelFor="@+id/token" android:layout_marginBottom="8dp" android:gravity="start" android:fontFamily="@font/vazirmatn" android:includeFontPadding="false" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" app:helperText="@string/keep_token" app:endIconMode="password_toggle" android:id="@+id/token_layout" app:hintEnabled="false">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/token" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="textPassword" android:maxLines="1" android:textSize="14sp" android:textDirection="ltr" android:saveEnabled="false" android:imeOptions="actionNext" android:textColor="@color/cl_ink" android:fontFeatureSettings="'tnum'" android:includeFontPadding="false" android:paddingStart="14dp" android:paddingEnd="14dp" />
            </com.google.android.material.textfield.TextInputLayout>
            <Space android:layout_width="1dp" android:layout_height="12dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/server_advanced_toggle" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/server_advanced" android:textSize="14sp" style="@style/Widget.Material3.Button.TextButton" app:iconGravity="textStart" />
            <LinearLayout android:id="@+id/server_advanced_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/clear_token" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/clear_token" android:textSize="12sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_neutral" android:padding="14dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/advanced" android:textSize="14sp" android:textColor="@color/cl_ink" android:fontFamily="@font/vazirmatn" android:gravity="start" android:includeFontPadding="false" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/allow_http" android:textSize="12sp" android:textColor="@color/cl_ink" android:fontFamily="@font/vazirmatn" android:gravity="start" android:includeFontPadding="false" />
                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/allow_http" android:layout_width="wrap_content" android:layout_height="48dp" android:contentDescription="@string/allow_http" />
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/http_caption" android:textSize="12sp" android:textColor="@color/cl_muted" android:fontFamily="@font/vazirmatn" android:gravity="start" android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>
            <Space android:layout_width="1dp" android:layout_height="12dp" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="14dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_surface" android:padding="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/schedule_title" android:textSize="16sp" android:textColor="@color/cl_ink" android:fontFamily="@font/vazirmatn_semibold" android:gravity="start" android:includeFontPadding="false" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/schedule_caption" android:textSize="12sp" android:textColor="@color/cl_muted" android:fontFamily="@font/vazirmatn" android:gravity="start" android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>
            <Space android:layout_width="1dp" android:layout_height="14dp" />
            <com.google.android.material.chip.ChipGroup android:id="@+id/schedule_presets" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" app:chipSpacingHorizontal="8dp" app:chipSpacingVertical="8dp">
                <com.google.android.material.chip.Chip android:id="@+id/preset_60" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/preset_1m" android:checkable="true" android:textSize="12sp" app:ensureMinTouchTargetSize="true" />
                <com.google.android.material.chip.Chip android:id="@+id/preset_300" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/preset_5m" android:checkable="true" android:textSize="12sp" app:ensureMinTouchTargetSize="true" />
                <com.google.android.material.chip.Chip android:id="@+id/preset_900" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/preset_15m" android:checkable="true" android:textSize="12sp" app:ensureMinTouchTargetSize="true" />
                <com.google.android.material.chip.Chip android:id="@+id/preset_3600" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/preset_60m" android:checkable="true" android:textSize="12sp" app:ensureMinTouchTargetSize="true" />
            </com.google.android.material.chip.ChipGroup>
            <Space android:layout_width="1dp" android:layout_height="12dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sample_interval" android:textSize="14sp" android:textColor="@color/cl_ink" android:labelFor="@+id/sample" android:layout_marginBottom="8dp" android:gravity="start" android:fontFamily="@font/vazirmatn" android:includeFontPadding="false" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/sample_layout" app:helperText="@string/sample_range" app:hintEnabled="false">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/sample" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="number" android:maxLines="1" android:textSize="14sp" android:textDirection="ltr" android:saveEnabled="false" android:imeOptions="actionNext" android:textColor="@color/cl_ink" android:fontFeatureSettings="'tnum'" android:includeFontPadding="false" android:paddingStart="14dp" android:paddingEnd="14dp" />
            </com.google.android.material.textfield.TextInputLayout>
            <Space android:layout_width="1dp" android:layout_height="12dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/upload_every" android:textSize="14sp" android:textColor="@color/cl_ink" android:labelFor="@+id/every" android:layout_marginBottom="8dp" android:gravity="start" android:fontFamily="@font/vazirmatn" android:includeFontPadding="false" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/every_layout" app:helperText="@string/upload_range" app:hintEnabled="false">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/every" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="number" android:maxLines="1" android:textSize="14sp" android:textDirection="ltr" android:saveEnabled="false" android:imeOptions="actionDone" android:textColor="@color/cl_ink" android:fontFeatureSettings="'tnum'" android:includeFontPadding="false" android:paddingStart="14dp" android:paddingEnd="14dp" />
            </com.google.android.material.textfield.TextInputLayout>
            <Space android:layout_width="1dp" android:layout_height="12dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/schedule_empty" android:textSize="12sp" android:textColor="@color/cl_primary" android:fontFamily="@font/vazirmatn" android:gravity="start" android:id="@+id/schedule_summary" android:includeFontPadding="false" />
            <Space android:layout_width="1dp" android:layout_height="12dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/buffer_hint" android:textSize="12sp" android:textColor="@color/cl_muted" android:fontFamily="@font/vazirmatn" android:gravity="start" android:includeFontPadding="false" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="20dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/save_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="54dp" android:text="@string/save" android:textSize="14sp" android:fontFamily="@font/vazirmatn_semibold" android:textAllCaps="false" app:icon="@drawable/ic_check" app:iconGravity="textStart" style="@style/Widget.ClimateLink.Button" />
        <Space android:layout_width="1dp" android:layout_height="10dp" />
        <com.google.android.material.button.MaterialButton style="@style/Widget.ClimateLink.Button.Outlined" android:id="@+id/run_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="54dp" android:text="@string/run" android:textSize="14sp" android:fontFamily="@font/vazirmatn_semibold" android:textAllCaps="false" app:icon="@drawable/ic_moon" app:iconGravity="textStart" />
        <Space android:layout_width="1dp" android:layout_height="10dp" />
        <com.google.android.material.button.MaterialButton style="@style/Widget.ClimateLink.Button.Outlined" android:id="@+id/refresh_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="54dp" android:text="@string/refresh" android:textSize="14sp" android:fontFamily="@font/vazirmatn_semibold" android:textAllCaps="false" app:icon="@drawable/ic_refresh" app:iconGravity="textStart" />
        <Space android:layout_width="1dp" android:layout_height="10dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/prototype_note" android:textSize="12sp" android:textColor="@color/cl_muted" android:fontFamily="@font/vazirmatn" android:gravity="center_horizontal" android:textAlignment="center" android:includeFontPadding="false" />
    </LinearLayout>
</ScrollView>
