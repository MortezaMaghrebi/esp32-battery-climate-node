                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/wifi_title" android:textSize="16sp" android:textColor="@color/cl_ink" android:fontFamily="@font/vazirmatn_semibold" android:gravity="start" android:includeFontPadding="false" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/wifi_caption" android:textSize="12sp" android:textColor="@color/cl_muted" android:fontFamily="@font/vazirmatn" android:gravity="start" android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>
            <Space android:layout_width="1dp" android:layout_height="14dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ssid" android:textSize="14sp" android:textColor="@color/cl_ink" android:labelFor="@+id/ssid" android:layout_marginBottom="8dp" android:gravity="start" android:fontFamily="@font/vazirmatn" android:includeFontPadding="false" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/ssid_layout" app:hintEnabled="false">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/ssid" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="text" android:maxLines="1" android:textSize="14sp" android:textDirection="ltr" android:saveEnabled="false" android:imeOptions="actionNext" android:textColor="@color/cl_ink" android:fontFeatureSettings="'tnum'" android:includeFontPadding="false" android:paddingStart="14dp" android:paddingEnd="14dp" />
            </com.google.android.material.textfield.TextInputLayout>
            <Space android:layout_width="1dp" android:layout_height="12dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/wifi_password" android:textSize="14sp" android:textColor="@color/cl_ink" android:labelFor="@+id/password" android:layout_marginBottom="8dp" android:gravity="start" android:fontFamily="@font/vazirmatn" android:includeFontPadding="false" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" app:helperText="@string/keep_password" app:endIconMode="password_toggle" android:id="@+id/password_layout" app:hintEnabled="false">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/password" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="textPassword" android:maxLines="1" android:textSize="14sp" android:textDirection="ltr" android:saveEnabled="false" android:imeOptions="actionNext" android:textColor="@color/cl_ink" android:fontFeatureSettings="'tnum'" android:includeFontPadding="false" android:paddingStart="14dp" android:paddingEnd="14dp" />
            </com.google.android.material.textfield.TextInputLayout>
            <Space android:layout_width="1dp" android:layout_height="12dp" />
