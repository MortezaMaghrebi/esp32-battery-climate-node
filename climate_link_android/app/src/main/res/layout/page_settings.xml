<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/settings_page" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/page_gutter" android:paddingEnd="@dimen/page_gutter" android:paddingTop="8dp" android:paddingBottom="28dp">
        <Space android:layout_width="1dp" android:layout_height="2dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_title" android:textSize="24sp" android:textColor="@color/cl_ink" android:fontFamily="@font/vazirmatn_semibold" android:gravity="start" android:accessibilityHeading="true" android:includeFontPadding="false" />
        <Space android:layout_width="1dp" android:layout_height="6dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_caption" android:textSize="14sp" android:textColor="@color/cl_muted" android:fontFamily="@font/vazirmatn" android:gravity="start" android:includeFontPadding="false" />
        <Space android:layout_width="1dp" android:layout_height="20dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_notice" android:padding="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_locked" android:textSize="12sp" android:textColor="@color/cl_primary" android:fontFamily="@font/vazirmatn" android:gravity="start" android:id="@+id/settings_notice" android:includeFontPadding="false" />
        </LinearLayout>
        <LinearLayout android:id="@+id/form_errors" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_warm" android:padding="16dp" android:visibility="gone" android:layout_marginBottom="16dp" />
        <Space android:layout_width="1dp" android:layout_height="14dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_surface" android:padding="20dp">
