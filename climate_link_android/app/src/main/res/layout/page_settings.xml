<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/settings_page" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="12dp" android:paddingBottom="28dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_eyebrow" android:textSize="12sp" android:textColor="@color/cl_muted" android:fontFamily="@font/vazirmatn" android:gravity="start" />
        <Space android:layout_width="1dp" android:layout_height="2dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_title" android:textSize="28sp" android:textColor="@color/cl_ink" android:fontFamily="@font/vazirmatn" android:gravity="start" />
        <Space android:layout_width="1dp" android:layout_height="6dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_caption" android:textSize="13sp" android:textColor="@color/cl_muted" android:fontFamily="@font/vazirmatn" android:gravity="start" />
        <Space android:layout_width="1dp" android:layout_height="20dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_notice" android:padding="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_locked" android:textSize="12sp" android:textColor="@color/cl_primary" android:fontFamily="@font/vazirmatn" android:gravity="start" android:id="@+id/settings_notice" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="16dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_surface" android:padding="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_wifi" app:tint="@color/cl_primary" android:importantForAccessibility="no" android:layout_marginEnd="12dp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/wifi_title" android:textSize="17sp" android:textColor="@color/cl_ink" android:fontFamily="@font/vazirmatn" android:gravity="start" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/wifi_caption" android:textSize="12sp" android:textColor="@color/cl_muted" android:fontFamily="@font/vazirmatn" android:gravity="start" />
                </LinearLayout>
            </LinearLayout>
            <Space android:layout_width="1dp" android:layout_height="16dp" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/ssid">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/ssid" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="text" android:maxLines="1" android:textSize="14sp" android:textDirection="ltr" android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>
            <Space android:layout_width="1dp" android:layout_height="12dp" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/wifi_password" app:helperText="@string/keep_password" app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/password" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="textPassword" android:maxLines="1" android:textSize="14sp" android:textDirection="ltr" android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>
            <Space android:layout_width="1dp" android:layout_height="12dp" />
            <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/clear_password" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/clear_password" android:textSize="12sp" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="16dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_surface" android:padding="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_server" app:tint="@color/cl_primary" android:importantForAccessibility="no" android:layout_marginEnd="12dp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/server_title" android:textSize="17sp" android:textColor="@color/cl_ink" android:fontFamily="@font/vazirmatn" android:gravity="start" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/server_caption" android:textSize="12sp" android:textColor="@color/cl_muted" android:fontFamily="@font/vazirmatn" android:gravity="start" />
                </LinearLayout>
            </LinearLayout>
            <Space android:layout_width="1dp" android:layout_height="16dp" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/server_url" app:placeholderText="@string/server_placeholder">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/url" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="textUri" android:maxLines="1" android:textSize="14sp" android:textDirection="ltr" android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>
            <Space android:layout_width="1dp" android:layout_height="12dp" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/server_token" app:helperText="@string/keep_token" app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/token" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="textPassword" android:maxLines="1" android:textSize="14sp" android:textDirection="ltr" android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>
            <Space android:layout_width="1dp" android:layout_height="12dp" />
            <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/clear_token" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/clear_token" android:textSize="12sp" />
            <Space android:layout_width="1dp" android:layout_height="12dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_neutral" android:padding="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/advanced" android:textSize="13sp" android:textColor="@color/cl_ink" android:fontFamily="@font/vazirmatn" android:gravity="start" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/allow_http" android:textSize="12sp" android:textColor="@color/cl_ink" android:fontFamily="@font/vazirmatn" android:gravity="start" />
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/allow_http" android:layout_width="wrap_content" android:layout_height="48dp" android:contentDescription="@string/allow_http" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/http_caption" android:textSize="11sp" android:textColor="@color/cl_muted" android:fontFamily="@font/vazirmatn" android:gravity="start" />
            </LinearLayout>
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="16dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_surface" android:padding="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_clock" app:tint="@color/cl_primary" android:importantForAccessibility="no" android:layout_marginEnd="12dp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/schedule_title" android:textSize="17sp" android:textColor="@color/cl_ink" android:fontFamily="@font/vazirmatn" android:gravity="start" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/schedule_caption" android:textSize="12sp" android:textColor="@color/cl_muted" android:fontFamily="@font/vazirmatn" android:gravity="start" />
                </LinearLayout>
            </LinearLayout>
            <Space android:layout_width="1dp" android:layout_height="16dp" />
            <com.google.android.material.chip.ChipGroup android:id="@+id/schedule_presets" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" app:chipSpacingHorizontal="4dp">
                <com.google.android.material.chip.Chip android:id="@+id/preset_60" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/preset_1m" android:checkable="true" android:textSize="11sp" app:ensureMinTouchTargetSize="true" />
                <com.google.android.material.chip.Chip android:id="@+id/preset_300" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/preset_5m" android:checkable="true" android:textSize="11sp" app:ensureMinTouchTargetSize="true" />
                <com.google.android.material.chip.Chip android:id="@+id/preset_900" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/preset_15m" android:checkable="true" android:textSize="11sp" app:ensureMinTouchTargetSize="true" />
                <com.google.android.material.chip.Chip android:id="@+id/preset_3600" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/preset_60m" android:checkable="true" android:textSize="11sp" app:ensureMinTouchTargetSize="true" />
            </com.google.android.material.chip.ChipGroup>
            <Space android:layout_width="1dp" android:layout_height="12dp" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/sample_interval">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/sample" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="number" android:maxLines="1" android:textSize="14sp" android:textDirection="ltr" android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>
            <Space android:layout_width="1dp" android:layout_height="12dp" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/upload_every">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/every" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="number" android:maxLines="1" android:textSize="14sp" android:textDirection="ltr" android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>
            <Space android:layout_width="1dp" android:layout_height="12dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/schedule_empty" android:textSize="12sp" android:textColor="@color/cl_primary" android:fontFamily="@font/vazirmatn" android:gravity="start" android:id="@+id/schedule_summary" />
            <Space android:layout_width="1dp" android:layout_height="12dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/buffer_hint" android:textSize="11sp" android:textColor="@color/cl_muted" android:fontFamily="@font/vazirmatn" android:gravity="start" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="20dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/save_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="54dp" android:text="@string/save" android:textSize="14sp" android:fontFamily="@font/vazirmatn_semibold" android:textAllCaps="false" app:cornerRadius="16dp" app:icon="@drawable/ic_check" app:iconGravity="textStart" />
        <Space android:layout_width="1dp" android:layout_height="10dp" />
        <com.google.android.material.button.MaterialButton style="@style/Widget.Material3.Button.OutlinedButton" android:id="@+id/run_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="54dp" android:text="@string/run" android:textSize="14sp" android:fontFamily="@font/vazirmatn_semibold" android:textAllCaps="false" app:cornerRadius="16dp" app:icon="@drawable/ic_moon" app:iconGravity="textStart" />
        <Space android:layout_width="1dp" android:layout_height="10dp" />
        <com.google.android.material.button.MaterialButton style="@style/Widget.Material3.Button.OutlinedButton" android:id="@+id/refresh_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="54dp" android:text="@string/refresh" android:textSize="14sp" android:fontFamily="@font/vazirmatn_semibold" android:textAllCaps="false" app:cornerRadius="16dp" app:icon="@drawable/ic_refresh" app:iconGravity="textStart" />
        <Space android:layout_width="1dp" android:layout_height="10dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/prototype_note" android:textSize="11sp" android:textColor="@color/cl_muted" android:fontFamily="@font/vazirmatn" android:gravity="center_horizontal" android:textAlignment="center" />
    </LinearLayout>
</ScrollView>
    
