<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/overview_page" android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/page_gutter" android:paddingEnd="@dimen/page_gutter" android:paddingTop="8dp" android:paddingBottom="28dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/overview_intro">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/overview_title" android:textSize="24sp" android:textColor="@color/cl_ink" android:fontFamily="@font/vazirmatn_semibold" android:accessibilityHeading="true" android:gravity="start" android:includeFontPadding="false" />
            <Space android:layout_width="1dp" android:layout_height="14dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@drawable/bg_surface">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/last_sample" android:textSize="16sp" android:textColor="@color/cl_ink" android:layout_weight="1" android:id="@+id/reading_state" android:gravity="start" android:includeFontPadding="false" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/simulated" android:textSize="12sp" android:textColor="@color/cl_accent" android:id="@+id/simulation_badge" android:background="@drawable/bg_warm" android:gravity="start" android:includeFontPadding="false" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" />
            </LinearLayout>
            <Space android:layout_width="1dp" android:layout_height="12dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:gravity="top" android:id="@+id/measurement_grid">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/temperature" android:textSize="14sp" android:textColor="@color/cl_muted" android:gravity="start" android:includeFontPadding="false" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/empty_value" android:textSize="22sp" android:textColor="@color/cl_muted" android:id="@+id/temperature_value" android:minHeight="40dp" android:gravity="start|center_vertical" android:textDirection="ltr" android:fontFeatureSettings="'tnum'" android:contentDescription="@string/temperature_unknown" android:includeFontPadding="false" android:textAlignment="viewStart" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/unit_temperature" android:textSize="12sp" android:textColor="@color/cl_muted" android:textDirection="ltr" android:gravity="start" android:includeFontPadding="false" android:textAlignment="viewStart" />
                </LinearLayout>
                <View android:layout_width="1dp" android:layout_height="76dp" android:background="@color/cl_outline" android:layout_marginStart="14dp" android:layout_marginEnd="14dp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/humidity" android:textSize="14sp" android:textColor="@color/cl_muted" android:gravity="start" android:includeFontPadding="false" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/empty_value" android:textSize="22sp" android:textColor="@color/cl_muted" android:id="@+id/humidity_value" android:minHeight="40dp" android:gravity="start|center_vertical" android:textDirection="ltr" android:fontFeatureSettings="'tnum'" android:contentDescription="@string/humidity_unknown" android:includeFontPadding="false" android:textAlignment="viewStart" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/unit_humidity" android:textSize="12sp" android:textColor="@color/cl_muted" android:textDirection="ltr" android:gravity="start" android:includeFontPadding="false" android:textAlignment="viewStart" />
                </LinearLayout>
            </LinearLayout>
            <Space android:layout_width="1dp" android:layout_height="14dp" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/cl_outline" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/no_sample" android:textSize="12sp" android:textColor="@color/cl_muted" android:id="@+id/sample_caption" android:layout_marginTop="12dp" android:gravity="start" android:includeFontPadding="false" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@drawable/bg_surface" android:layout_marginTop="14dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hero_title" android:textSize="16sp" android:textColor="@color/cl_ink" android:id="@+id/hero_title" android:fontFamily="@font/vazirmatn_semibold" android:gravity="start" android:includeFontPadding="false" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hero_caption" android:textSize="14sp" android:textColor="@color/cl_muted" android:id="@+id/hero_caption" android:layout_marginTop="6dp" android:gravity="start" android:includeFontPadding="false" />
            <Space android:layout_width="1dp" android:layout_height="14dp" />
            <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/go_devices" android:text="@string/connect_device" style="@style/Widget.ClimateLink.Button" app:icon="@drawable/ic_arrow" app:iconGravity="textStart" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@drawable/bg_surface" android:id="@+id/connected_details" android:visibility="gone" android:layout_marginTop="14dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/device_connection" android:textSize="16sp" android:textColor="@color/cl_ink" android:gravity="start" android:includeFontPadding="false" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/no_device" android:textSize="14sp" android:textColor="@color/cl_ink" android:id="@+id/device_name" android:layout_marginTop="12dp" android:gravity="start" android:includeFontPadding="false" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/no_device_caption" android:textSize="12sp" android:textColor="@color/cl_muted" android:id="@+id/device_identity" android:layout_marginTop="6dp" android:fontFamily="monospace" android:textDirection="ltr" android:gravity="start" android:includeFontPadding="false" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@drawable/bg_surface" android:id="@+id/telemetry_card" android:visibility="gone" android:layout_marginTop="14dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/telemetry" android:textSize="16sp" android:textColor="@color/cl_ink" android:gravity="start" android:includeFontPadding="false" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical" android:layout_marginTop="10dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/queued" android:textSize="14sp" android:textColor="@color/cl_muted" android:layout_weight="1" android:gravity="start" android:includeFontPadding="false" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/empty_value" android:textSize="18sp" android:textColor="@color/cl_ink" android:id="@+id/queued_value" android:fontFeatureSettings="'tnum'" android:gravity="start" android:includeFontPadding="false" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical" android:layout_marginTop="10dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/failures" android:textSize="14sp" android:textColor="@color/cl_muted" android:layout_weight="1" android:gravity="start" android:includeFontPadding="false" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/empty_value" android:textSize="18sp" android:textColor="@color/cl_ink" android:id="@+id/failures_value" android:fontFeatureSettings="'tnum'" android:gravity="start" android:includeFontPadding="false" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical" android:layout_marginTop="10dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/dropped" android:textSize="14sp" android:textColor="@color/cl_muted" android:layout_weight="1" android:gravity="start" android:includeFontPadding="false" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/empty_value" android:textSize="18sp" android:textColor="@color/cl_ink" android:id="@+id/dropped_value" android:fontFeatureSettings="'tnum'" android:gravity="start" android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/cycle_title" android:textSize="14sp" android:textColor="@color/cl_ink" android:fontFamily="@font/vazirmatn_semibold" android:gravity="start" android:includeFontPadding="false" />
            <com.codestoon.climatelink.ClimateCycleView android:layout_width="match_parent" android:layout_height="24dp" android:layout_marginTop="10dp" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/cycle_wake" android:textSize="12sp" android:textColor="@color/cl_muted" android:layout_weight="1" android:gravity="center" android:textAlignment="center" android:includeFontPadding="false" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/cycle_sample" android:textSize="12sp" android:textColor="@color/cl_muted" android:layout_weight="1" android:gravity="center" android:textAlignment="center" android:includeFontPadding="false" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/cycle_send" android:textSize="12sp" android:textColor="@color/cl_muted" android:layout_weight="1" android:gravity="center" android:textAlignment="center" android:includeFontPadding="false" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/cycle_sleep" android:textSize="12sp" android:textColor="@color/cl_muted" android:layout_weight="1" android:gravity="center" android:textAlignment="center" android:includeFontPadding="false" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/cycle_caption" android:textSize="12sp" android:textColor="@color/cl_muted" android:layout_marginTop="12dp" android:gravity="start" android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
