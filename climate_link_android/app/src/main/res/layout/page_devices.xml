<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/devices_page" android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/page_gutter" android:paddingEnd="@dimen/page_gutter" android:paddingTop="8dp" android:paddingBottom="28dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/devices_title" android:textSize="24sp" android:textColor="@color/cl_ink" android:fontFamily="@font/vazirmatn_semibold" android:accessibilityHeading="true" android:gravity="start" android:includeFontPadding="false" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/devices_caption" android:textSize="14sp" android:textColor="@color/cl_muted" android:layout_marginTop="4dp" android:gravity="start" android:includeFontPadding="false" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@drawable/bg_surface" android:layout_marginTop="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/wake_title" android:textSize="16sp" android:textColor="@color/cl_ink" android:fontFamily="@font/vazirmatn_semibold" android:gravity="start" android:includeFontPadding="false" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/wake_caption" android:textSize="14sp" android:textColor="@color/cl_muted" android:layout_marginTop="6dp" android:gravity="start" android:includeFontPadding="false" />
            <Space android:layout_width="1dp" android:layout_height="14dp" />
            <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/scan_button" android:text="@string/scan" style="@style/Widget.ClimateLink.Button" app:icon="@drawable/ic_search" app:iconGravity="textStart" />
            <com.google.android.material.progressindicator.LinearProgressIndicator android:layout_width="match_parent" android:layout_height="3dp" android:id="@+id/scan_progress" android:indeterminate="true" android:visibility="gone" android:layout_marginTop="14dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/status_initial" android:textSize="12sp" android:textColor="@color/cl_muted" android:id="@+id/connection" android:layout_marginTop="12dp" android:gravity="start" android:includeFontPadding="false" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:layout_marginTop="24dp" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/nearby" android:textSize="16sp" android:textColor="@color/cl_ink" android:layout_weight="1" android:accessibilityHeading="true" android:gravity="start" android:includeFontPadding="false" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/empty_value" android:textSize="12sp" android:textColor="@color/cl_muted" android:id="@+id/device_count" android:gravity="start" android:includeFontPadding="false" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@drawable/bg_surface" android:id="@+id/empty_devices" android:layout_marginTop="14dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/none_found" android:textSize="14sp" android:textColor="@color/cl_ink" android:gravity="start" android:includeFontPadding="false" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/scan_hint" android:textSize="12sp" android:textColor="@color/cl_muted" android:layout_marginTop="6dp" android:gravity="start" android:includeFontPadding="false" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/device_list" android:layout_marginTop="14dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pair_hint" android:textSize="12sp" android:textColor="@color/cl_muted" android:layout_marginTop="14dp" android:gravity="start" android:includeFontPadding="false" />
        <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/disconnect_button" android:text="@string/disconnect" style="@style/Widget.ClimateLink.Button.Outlined" android:visibility="gone" android:layout_marginTop="14dp" />
    </LinearLayout>
</ScrollView>
