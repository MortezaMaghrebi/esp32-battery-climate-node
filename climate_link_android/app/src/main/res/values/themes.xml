<resources>
  <style name="Base.Theme.ClimateLink" parent="Theme.Material3.Light.NoActionBar">
    <item name="colorPrimary">@color/cl_primary</item>
    <item name="colorOnPrimary">@color/cl_on_primary</item>
    <item name="colorPrimaryContainer">@color/cl_raised</item>
    <item name="colorOnPrimaryContainer">@color/cl_ink</item>
    <item name="colorSecondary">@color/cl_primary</item>
    <item name="colorSecondaryContainer">@color/cl_raised</item>
    <item name="colorOnSecondaryContainer">@color/cl_ink</item>
    <item name="colorSurface">@color/cl_surface</item>
    <item name="colorOnSurface">@color/cl_ink</item>
    <item name="colorSurfaceVariant">@color/cl_raised</item>
    <item name="colorOnSurfaceVariant">@color/cl_muted</item>
    <item name="colorSurfaceContainer">@color/cl_surface</item>
    <item name="colorSurfaceContainerHigh">@color/cl_raised</item>
    <item name="colorOutline">@color/cl_field_outline</item>
    <item name="colorError">@color/cl_error</item>
    <item name="android:colorBackground">@color/cl_background</item>
    <item name="android:windowBackground">@color/cl_background</item>
    <item name="fontFamily">@font/vazirmatn</item>
    <item name="android:fontFamily">@font/vazirmatn</item>
    <item name="android:windowLightStatusBar">true</item>
    <item name="android:statusBarColor">@color/cl_background</item>
    <item name="android:navigationBarColor">@color/cl_background</item>
    <item name="android:windowActionModeOverlay">true</item>
    <item name="materialButtonStyle">@style/Widget.ClimateLink.Button</item>
    <item name="textInputStyle">@style/Widget.ClimateLink.TextInput</item>
    <item name="materialButtonOutlinedStyle">@style/Widget.ClimateLink.Button.Outlined</item>
  </style>
  <style name="Theme.ClimateLink" parent="Base.Theme.ClimateLink" />
  <style name="Widget.ClimateLink.Button" parent="Widget.Material3.Button">
    <item name="cornerRadius">999dp</item>
    <item name="android:minHeight">52dp</item>
    <item name="android:textSize">14sp</item>
    <item name="android:fontFamily">@font/vazirmatn_semibold</item>
    <item name="android:insetTop">0dp</item>
    <item name="android:insetBottom">0dp</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:elevation">0dp</item>
    <item name="android:stateListAnimator">@null</item>
    <item name="backgroundTint">@null</item>
    <item name="android:background">@drawable/bg_primary_button</item>
    <item name="android:textColor">@color/primary_button_ink</item>
    <item name="iconTint">@color/primary_button_ink</item>
    <item name="iconSize">18dp</item>
  </style>
  <style name="Widget.ClimateLink.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
    <item name="cornerRadius">999dp</item>
    <item name="android:minHeight">52dp</item>
    <item name="android:textSize">14sp</item>
    <item name="android:fontFamily">@font/vazirmatn_semibold</item>
    <item name="android:insetTop">0dp</item>
    <item name="android:insetBottom">0dp</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:textColor">@color/secondary_button_ink</item>
    <item name="iconTint">@color/secondary_button_ink</item>
    <item name="iconSize">18dp</item>
    <item name="strokeColor">@color/input_stroke</item>
  </style>
  <style name="Widget.ClimateLink.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
    <item name="boxCornerRadiusTopStart">10dp</item>
    <item name="boxCornerRadiusTopEnd">10dp</item>
    <item name="boxCornerRadiusBottomStart">10dp</item>
    <item name="boxCornerRadiusBottomEnd">10dp</item>
    <item name="boxStrokeColor">@color/input_stroke</item>
    <item name="boxBackgroundColor">@color/cl_surface</item>
    <item name="helperTextTextColor">@color/cl_muted</item>
    <item name="errorTextColor">@color/cl_error</item>
    <item name="endIconTint">@color/cl_muted</item>
  </style>
  <style name="TextAppearance.ClimateLink.Nav" parent="TextAppearance.Material3.LabelMedium">
    <item name="fontFamily">@font/vazirmatn</item>
    <item name="android:textSize">11sp</item>
    <item name="android:includeFontPadding">false</item>
  </style>
  <style name="Widget.ClimateLink.NavIndicator" parent="">
    <item name="android:color">@color/cl_mint</item>
    <item name="android:width">64dp</item>
    <item name="android:height">40dp</item>
    <item name="shapeAppearance">@style/ShapeAppearance.ClimateLink.Nav</item>
  </style>
  <style name="ShapeAppearance.ClimateLink.Nav" parent="">
    <item name="cornerFamily">rounded</item>
    <item name="cornerSize">16dp</item>
  </style>
</resources>